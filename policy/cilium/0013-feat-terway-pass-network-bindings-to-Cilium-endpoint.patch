diff --git a/pkg/terway/binding.go b/pkg/terway/binding.go
new file mode 100644
index 0000000000..5f2d420b82
--- /dev/null
+++ b/pkg/terway/binding.go
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+// Package terway contains the contract shared by the Terway CNI chainer and
+// Cilium's built-in Terway datapath extension.
+package terway
+
+import (
+	"fmt"
+	"net"
+	"strconv"
+)
+
+const (
+	PluginName        = "terway-vlan"
+	VLANProperty      = "terway-vlan-id"
+	ParentMACProperty = "terway-parent-mac"
+)
+
+// Binding is persisted in Endpoint properties, which are already part of the
+// normal Cilium endpoint restore format. A zero VLAN denotes an ordinary ENI.
+type Binding struct {
+	VLAN      uint16
+	ParentMAC string
+}
+
+func (b Binding) Properties() map[string]any {
+	return map[string]any{VLANProperty: strconv.FormatUint(uint64(b.VLAN), 10), ParentMACProperty: b.ParentMAC}
+}
+
+func ParseBinding(get func(string) any) (Binding, bool, error) {
+	raw := get(VLANProperty)
+	if raw == nil {
+		return Binding{}, false, nil
+	}
+	s, ok := raw.(string)
+	if !ok {
+		return Binding{}, true, fmt.Errorf("%s must be a decimal string", VLANProperty)
+	}
+	id, err := strconv.ParseUint(s, 10, 16)
+	if err != nil || id > 4094 {
+		return Binding{}, true, fmt.Errorf("invalid Terway VLAN ID %q", s)
+	}
+	mac, ok := get(ParentMACProperty).(string)
+	hw, err := net.ParseMAC(mac)
+	if !ok || err != nil || len(hw) != 6 || hw[0]&1 != 0 {
+		return Binding{}, true, fmt.Errorf("invalid Terway parent MAC %q", mac)
+	}
+	return Binding{VLAN: uint16(id), ParentMAC: hw.String()}, true, nil
+}
diff --git a/pkg/terway/binding_test.go b/pkg/terway/binding_test.go
new file mode 100644
index 0000000000..683403ccb8
--- /dev/null
+++ b/pkg/terway/binding_test.go
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package terway
+
+import (
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestBindingProperties(t *testing.T) {
+	for _, id := range []uint16{0, 1, 4094} {
+		want := Binding{VLAN: id, ParentMAC: "02:00:00:00:00:01"}
+		props := want.Properties()
+		got, present, err := ParseBinding(func(k string) any { return props[k] })
+		require.NoError(t, err)
+		require.True(t, present)
+		require.Equal(t, want, got)
+	}
+	for _, raw := range []any{"-1", "4095", "65536", "abc", float64(1), 1} {
+		_, _, err := ParseBinding(func(k string) any {
+			if k == VLANProperty {
+				return raw
+			}
+			return "02:00:00:00:00:01"
+		})
+		require.Error(t, err)
+	}
+	_, present, err := ParseBinding(func(string) any { return nil })
+	require.NoError(t, err)
+	require.False(t, present)
+	_, _, err = ParseBinding(func(k string) any {
+		if k == VLANProperty {
+			return "1"
+		}
+		return "ff:ff:ff:ff:ff:ff"
+	})
+	require.Error(t, err)
+}
