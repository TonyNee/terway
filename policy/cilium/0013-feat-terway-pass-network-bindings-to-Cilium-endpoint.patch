 package terway
 
 import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/vishvananda/netlink"
+
+	"github.com/cilium/cilium/api/v1/models"
 	chainingapi "github.com/cilium/cilium/plugins/cilium-cni/chaining/api"
 	genericveth "github.com/cilium/cilium/plugins/cilium-cni/chaining/generic-veth"
 )
 
-var (
+const (
 	name = "terway-chainer"
+	// Shared with Terway's host-veth setup, without changing CNI result types.
+	trunkDatapathAlias = "terway-trunk-datapath"
 )
 
 func init() {
-	chainingapi.Register(name, &genericveth.GenericVethChainer{})
+	chainingapi.Register(name, &genericveth.GenericVethChainer{UsesEndpointBinding: usesTrunkBinding, ConfigureEndpoint: configureEndpoint})
+}
+
+func usesTrunkBinding(peer netlink.Link) bool {
+	return peer.Attrs().Alias == trunkDatapathAlias
+}
+
+func configureEndpoint(ctx context.Context, p chainingapi.PluginContext, ep *models.EndpointChangeRequest) error {
+	if !p.NetConf.TerwayDatapath {
+		return fmt.Errorf("Terway trunk veth requires terway-datapath in the CNI configuration")
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	binding, err := queryBinding(ctx, backendSocket, string(p.CniArgs.K8S_POD_NAMESPACE), string(p.CniArgs.K8S_POD_NAME), p.Args.ContainerID, p.Args.IfName, ep.Addressing)
+	if err != nil {
+		return err
+	}
+	if binding.VLAN == 0 {
+		return fmt.Errorf("Terway trunk datapath requires a nonzero VLAN allocation")
+	}
+	links, err := netlink.LinkList()
+	if err != nil {
+		return err
+	}
+	parent := 0
+	for _, link := range links {
+		if link.Attrs().HardwareAddr.String() == binding.ParentMAC {
+			if parent != 0 {
+				return fmt.Errorf("ambiguous parent ENI MAC %s", binding.ParentMAC)
+			}
+			parent = link.Attrs().Index
+		}
+	}
+	if parent == 0 {
+		return fmt.Errorf("parent ENI %s not found", binding.ParentMAC)
+	}
+	ep.ParentInterfaceIndex = int64(parent)
+	if ep.Properties == nil {
+		ep.Properties = map[string]any{}
+	}
+	for key, val := range binding.Properties() {
+		ep.Properties[key] = val
+	}
+	return nil
 }
