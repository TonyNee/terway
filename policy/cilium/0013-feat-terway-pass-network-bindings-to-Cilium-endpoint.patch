+	chainingapi "github.com/cilium/cilium/plugins/cilium-cni/chaining/api"
+	cnitypes "github.com/cilium/cilium/plugins/cilium-cni/types"
+)
+
+func TestBindingFromReply(t *testing.T) {
+	for _, tc := range []struct {
+		name, reply, ifname string
+		ips                 models.AddressPair
+		wantError           bool
+	}{
+		{"trunk", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2"}, false},
+		{"ipv6-secondary", `{"Success":true,"NetConfs":[{"IfName":"eth1","BasicInfo":{"PodIP":{"IPv6":"fd00::2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`, "eth1", models.AddressPair{IPv6: "fd00::2"}, false},
+		{"ordinary", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01"}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2"}, false},
+		{"dual-stack", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2","IPv6":"fd00::2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2", IPv6: "fd00::2"}, false},
+		{"wrong-ipv6", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2","IPv6":"fd00::2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2", IPv6: "fd00::3"}, true},
+		{"unexpected-ipv6", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2", IPv6: "fd00::2"}, true},
+		{"old-sandbox", `{"Success":true}`, "eth0", models.AddressPair{IPv4: "10.0.0.2"}, true},
+		{"wrong-ip", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.3"}},"ENIInfo":{"MAC":"02:00:00:00:00:01"}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2"}, true},
+		{"missing-vlan", `{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true}}]}`, "eth0", models.AddressPair{IPv4: "10.0.0.2"}, true},
+		{"not-ready", `{"Success":false}`, "eth0", models.AddressPair{}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			reply := dynamicpb.NewMessage(backendSchema.Messages().ByName("GetInfoReply"))
+			require.NoError(t, protojson.Unmarshal([]byte(tc.reply), reply))
+			_, err := bindingFromReply(reply, tc.ifname, &tc.ips)
+			if tc.wantError {
+				require.Error(t, err)
+			} else {
+				require.NoError(t, err)
+			}
+		})
+	}
+}
+
+func TestQueryBinding(t *testing.T) {
+	socket := filepath.Join(t.TempDir(), "backend.sock")
+	l, err := net.Listen("unix", socket)
+	require.NoError(t, err)
+	s := grpc.NewServer()
+	s.RegisterService(&grpc.ServiceDesc{ServiceName: "rpc.TerwayBackend", HandlerType: (*interface{})(nil), Methods: []grpc.MethodDesc{{MethodName: "GetIPInfo", Handler: func(_ any, _ context.Context, decode func(any) error, _ grpc.UnaryServerInterceptor) (any, error) {
+		req := dynamicpb.NewMessage(backendSchema.Messages().ByName("GetInfoRequest"))
+		if err := decode(req); err != nil {
+			return nil, err
+		}
+		require.Equal(t, "pod", getField(req, 1).String())
+		require.Equal(t, "ns", getField(req, 2).String())
+		require.Equal(t, "sandbox", getField(req, 3).String())
+		reply := dynamicpb.NewMessage(backendSchema.Messages().ByName("GetInfoReply"))
+		err := protojson.Unmarshal([]byte(`{"Success":true,"NetConfs":[{"BasicInfo":{"PodIP":{"IPv4":"10.0.0.2"}},"ENIInfo":{"MAC":"02:00:00:00:00:01","Trunk":true,"Vid":42}}]}`), reply)
+		return reply, err
+	}}}}, struct{}{})
+	go s.Serve(l)
+	t.Cleanup(s.Stop)
+	binding, err := queryBinding(t.Context(), "unix://"+socket, "ns", "pod", "sandbox", "eth0", &models.AddressPair{IPv4: "10.0.0.2"})
+	require.NoError(t, err)
+	require.Equal(t, uint16(42), binding.VLAN)
+}
+
+func TestOnlyTrunkVethUsesBackend(t *testing.T) {
+	for _, alias := range []string{"", "unrelated", trunkDatapathAlias + "-other"} {
+		require.False(t, usesTrunkBinding(&netlink.Veth{LinkAttrs: netlink.LinkAttrs{Alias: alias}}))
+	}
+	require.True(t, usesTrunkBinding(&netlink.Veth{LinkAttrs: netlink.LinkAttrs{Alias: trunkDatapathAlias}}))
+	p := chainingapi.PluginContext{NetConf: &cnitypes.NetConf{}}
+	require.ErrorContains(t, configureEndpoint(t.Context(), p, &models.EndpointChangeRequest{}), "requires terway-datapath")
+}
