@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package genericveth
+
+import (
+	"context"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	"github.com/vishvananda/netlink"
+
+	"github.com/cilium/cilium/api/v1/models"
+	chainingapi "github.com/cilium/cilium/plugins/cilium-cni/chaining/api"
+)
+
+func TestGetGlobalIPv6Address(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		addresses []string
+		want      string
+	}{
+		{name: "no-ipv6"},
+		{name: "ipv4-only-link-local", addresses: []string{"fe80::1234/64"}},
+		{name: "multiple-link-local", addresses: []string{"fe80::1234/64", "fe80::5678/64"}},
+		{name: "loopback", addresses: []string{"::1/128"}},
+		{name: "unspecified", addresses: []string{"::/128"}},
+		{name: "multicast", addresses: []string{"ff02::1/128"}},
+		{name: "unique-local", addresses: []string{"fd00::2/128"}, want: "fd00::2"},
+		{name: "global", addresses: []string{"2001:db8::2/128"}, want: "2001:db8::2"},
+		{name: "dual-stack-link-local-first", addresses: []string{"fe80::1234/64", "fd00::2/128"}, want: "fd00::2"},
+		{name: "dual-stack-global-first", addresses: []string{"2001:db8::2/128", "fe80::1234/64"}, want: "2001:db8::2"},
+		{name: "first-global", addresses: []string{"fe80::1234/64", "fd00::2/128", "fd00::3/128"}, want: "fd00::2"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var addrs []netlink.Addr
+			for _, ip := range tc.addresses {
+				addr, err := netlink.ParseAddr(ip)
+				require.NoError(t, err)
+				addrs = append(addrs, *addr)
+			}
+			require.Equal(t, tc.want, getGlobalIPv6Address(addrs))
+		})
+	}
+}
+
+func TestProviderBindingRequiresInterfaceSelection(t *testing.T) {
+	callback := func(context.Context, chainingapi.PluginContext, *models.EndpointChangeRequest) error { return nil }
+	for _, alias := range []string{"", "ordinary", "provider-trunk"} {
+		peer := &netlink.Veth{LinkAttrs: netlink.LinkAttrs{Alias: alias}}
+		chainer := &GenericVethChainer{ConfigureEndpoint: callback}
+		require.False(t, chainer.usesEndpointBinding(peer))
+		chainer.UsesEndpointBinding = func(link netlink.Link) bool { return link.Attrs().Alias == "provider-trunk" }
+		require.Equal(t, alias == "provider-trunk", chainer.usesEndpointBinding(peer))
+		chainer.ConfigureEndpoint = nil
+		require.False(t, chainer.usesEndpointBinding(peer))
+	}
+}
diff --git a/plugins/cilium-cni/chaining/terway/backend.go b/plugins/cilium-cni/chaining/terway/backend.go
new file mode 100644
index 0000000000..c6636ac1ca
--- /dev/null
+++ b/plugins/cilium-cni/chaining/terway/backend.go
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package terway
+
+import (
+	"context"
+	"fmt"
+	"net/netip"
+
+	"github.com/cilium/cilium/api/v1/models"
+	contract "github.com/cilium/cilium/pkg/terway"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/reflect/protodesc"
+	"google.golang.org/protobuf/reflect/protoreflect"
+	"google.golang.org/protobuf/types/descriptorpb"
+	"google.golang.org/protobuf/types/dynamicpb"
+)
+
+const backendSocket = "unix:///var/run/eni/eni.socket"
+
+// This is the read-only subset of Terway's rpc/rpc.proto used by GetIPInfo.
+// Descriptors keep the normal protobuf codec and unknown-field compatibility,
+// without importing Terway's daemon and its dependency graph into cilium-cni.
+var backendSchema = func() protoreflect.FileDescriptor {
+	field := func(name string, number int32, typ descriptorpb.FieldDescriptorProto_Type, message string, repeated bool) *descriptorpb.FieldDescriptorProto {
+		f := &descriptorpb.FieldDescriptorProto{Name: proto.String(name), Number: proto.Int32(number), Type: &typ}
+		if message != "" {
+			f.TypeName = proto.String(".rpc." + message)
+		}
+		if repeated {
+			f.Label = descriptorpb.FieldDescriptorProto_LABEL_REPEATED.Enum()
+		}
+		return f
+	}
+	str, msg := descriptorpb.FieldDescriptorProto_TYPE_STRING, descriptorpb.FieldDescriptorProto_TYPE_MESSAGE
+	boolean, u32 := descriptorpb.FieldDescriptorProto_TYPE_BOOL, descriptorpb.FieldDescriptorProto_TYPE_UINT32
+	desc, err := protodesc.NewFile(&descriptorpb.FileDescriptorProto{
+		Name: proto.String("terway-get-ip-info.proto"), Package: proto.String("rpc"), Syntax: proto.String("proto3"),
+		MessageType: []*descriptorpb.DescriptorProto{
+			{Name: proto.String("GetInfoRequest"), Field: []*descriptorpb.FieldDescriptorProto{field("K8sPodName", 1, str, "", false), field("K8sPodNamespace", 2, str, "", false), field("K8sPodInfraContainerId", 3, str, "", false)}},
+			{Name: proto.String("IPSet"), Field: []*descriptorpb.FieldDescriptorProto{field("IPv4", 1, str, "", false), field("IPv6", 2, str, "", false)}},
+			{Name: proto.String("BasicInfo"), Field: []*descriptorpb.FieldDescriptorProto{field("PodIP", 1, msg, "IPSet", false)}},
+			{Name: proto.String("ENIInfo"), Field: []*descriptorpb.FieldDescriptorProto{field("MAC", 1, str, "", false), field("Trunk", 2, boolean, "", false), field("Vid", 3, u32, "", false)}},
+			{Name: proto.String("NetConf"), Field: []*descriptorpb.FieldDescriptorProto{field("BasicInfo", 1, msg, "BasicInfo", false), field("ENIInfo", 2, msg, "ENIInfo", false), field("IfName", 4, str, "", false)}},
+			{Name: proto.String("GetInfoReply"), Field: []*descriptorpb.FieldDescriptorProto{field("Success", 2, boolean, "", false), field("NetConfs", 5, msg, "NetConf", true), field("Error", 7, u32, "", false)}},
+		},
+	}, nil)
+	if err != nil {
+		panic(err)
+	}
+	return desc
+}()
+
+func getField(m protoreflect.Message, number protoreflect.FieldNumber) protoreflect.Value {
+	return m.Get(m.Descriptor().Fields().ByNumber(number))
+}
+
+func queryBinding(ctx context.Context, address, namespace, pod, sandbox, ifname string, ips *models.AddressPair) (contract.Binding, error) {
+	conn, err := grpc.NewClient(address, grpc.WithTransportCredentials(insecure.NewCredentials()))
+	if err != nil {
+		return contract.Binding{}, err
+	}
+	defer conn.Close()
+	request := dynamicpb.NewMessage(backendSchema.Messages().ByName("GetInfoRequest"))
+	for i, s := range []string{pod, namespace, sandbox} {
+		request.Set(request.Descriptor().Fields().ByNumber(protoreflect.FieldNumber(i+1)), protoreflect.ValueOfString(s))
+	}
+	reply := dynamicpb.NewMessage(backendSchema.Messages().ByName("GetInfoReply"))
+	if err := conn.Invoke(ctx, "/rpc.TerwayBackend/GetIPInfo", request, reply); err != nil {
+		return contract.Binding{}, fmt.Errorf("query Terway network allocation: %w", err)
+	}
+	return bindingFromReply(reply, ifname, ips)
+}
+
+func bindingFromReply(reply protoreflect.Message, ifname string, ips *models.AddressPair) (contract.Binding, error) {
+	if !getField(reply, 2).Bool() || getField(reply, 7).Uint() != 0 || ips == nil || (ips.IPv4 == "" && ips.IPv6 == "") {
+		return contract.Binding{}, fmt.Errorf("Terway allocation is not ready")
+	}
+	var result contract.Binding
+	matches := 0
+	networks := getField(reply, 5).List()
+	for i := 0; i < networks.Len(); i++ {
+		n := networks.Get(i).Message()
+		name := getField(n, 4).String()
+		if name == "" {
+			name = "eth0"
+		}
+		if name != ifname {
+			continue
+		}
+		podIP := getField(getField(n, 1).Message(), 1).Message()
+		if ips.IPv4 != "" && !sameIP(getField(podIP, 1).String(), ips.IPv4) {
+			continue
+		}
+		if ips.IPv6 != "" && !sameIP(getField(podIP, 2).String(), ips.IPv6) {
+			continue
+		}
+		eni := getField(n, 2).Message()
+		vlan := getField(eni, 3).Uint()
+		if vlan > 4094 || (getField(eni, 2).Bool() && vlan == 0) || (!getField(eni, 2).Bool() && vlan != 0) {
+			return contract.Binding{}, fmt.Errorf("invalid Terway trunk/VLAN allocation")
+		}
+		props := (contract.Binding{VLAN: uint16(vlan), ParentMAC: getField(eni, 1).String()}).Properties()
+		var err error
+		result, _, err = contract.ParseBinding(func(k string) any { return props[k] })
+		if err != nil {
+			return contract.Binding{}, err
+		}
+		matches++
+	}
+	if matches != 1 {
+		return contract.Binding{}, fmt.Errorf("expected one Terway allocation for interface %s, found %d", ifname, matches)
+	}
+	return result, nil
+}
+
+func sameIP(a, b string) bool {
+	x, err := netip.ParseAddr(a)
+	y, otherErr := netip.ParseAddr(b)
+	return err == nil && otherErr == nil && x == y
+}
