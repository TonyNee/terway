--- /dev/null
+++ b/pkg/datapath/loader/terway_test.go
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package loader
+
+import (
+	"testing"
+
+	"github.com/cilium/cilium/api/v1/datapathplugins"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTerwayHookSelection(t *testing.T) {
+	p := &terwayPlugin{}
+	for _, host := range []bool{false, true} {
+		req := &datapathplugins.PrepareCollectionRequest{Collection: &datapathplugins.PrepareCollectionRequest_CollectionSpec{
+			Programs: map[string]*datapathplugins.PrepareCollectionRequest_CollectionSpec_ProgramSpec{
+				"cil_from_netdev": {}, "cil_to_netdev": {}, "cil_host_policy": {},
+			},
+		}, AttachmentContext: &datapathplugins.AttachmentContext{}}
+		if host {
+			req.AttachmentContext.Context = &datapathplugins.AttachmentContext_Host_{Host: &datapathplugins.AttachmentContext_Host{}}
+		}
+		resp, err := p.PrepareCollection(t.Context(), req)
+		require.NoError(t, err)
+		if !host {
+			require.Empty(t, resp.Hooks)
+			continue
+		}
+		require.Len(t, resp.Hooks, 2)
+		require.Equal(t, "cil_from_netdev", resp.Hooks[0].Target)
+		require.Equal(t, datapathplugins.HookType_PRE, resp.Hooks[0].Type)
+		require.Equal(t, "cil_to_netdev", resp.Hooks[1].Target)
+		require.Equal(t, datapathplugins.HookType_POST, resp.Hooks[1].Type)
+	}
+}
