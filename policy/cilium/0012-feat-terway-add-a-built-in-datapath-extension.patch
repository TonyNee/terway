--- /dev/null
+++ b/pkg/datapath/loader/terway.go
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package loader
+
+import (
+	"context"
+	"fmt"
+	"log/slog"
+	"os"
+	"path/filepath"
+	"sync"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/hive/cell"
+	"google.golang.org/grpc"
+
+	"github.com/cilium/cilium/api/v1/datapathplugins"
+	plugin "github.com/cilium/cilium/pkg/datapath/plugins/types"
+	api_v2alpha1 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2alpha1"
+	"github.com/cilium/cilium/pkg/option"
+)
+
+type terwayPluginOut struct {
+	cell.Out
+	Plugins []plugin.Plugin `group:"builtin-datapath-plugins,flatten"`
+}
+
+// The built-in client uses the same prepare/instrument protocol as an external
+// plugin, without a socket, CRD, or separate process. The registry exposes it
+// even when Kubernetes-managed datapath plugins are disabled.
+func newTerwayPlugin(logger *slog.Logger) terwayPluginOut {
+	if !option.Config.EnableTerwayDatapath {
+		return terwayPluginOut{}
+	}
+	return terwayPluginOut{Plugins: []plugin.Plugin{&terwayPlugin{logger: logger}}}
+}
+
+type terwayPlugin struct {
+	logger *slog.Logger
+	mu     sync.Mutex
+	spec   *ebpf.CollectionSpec
+}
+
+func (*terwayPlugin) Name() string { return "terway-vlan" }
+func (*terwayPlugin) AttachmentPolicy() api_v2alpha1.CiliumDatapathPluginAttachmentPolicy {
+	return api_v2alpha1.AttachmentPolicyAlways
+}
+func (p *terwayPlugin) DeepEqual(other plugin.Plugin) bool { return p == other }
+
+func (*terwayPlugin) PrepareCollection(_ context.Context, req *datapathplugins.PrepareCollectionRequest, _ ...grpc.CallOption) (*datapathplugins.PrepareCollectionResponse, error) {
+	resp := &datapathplugins.PrepareCollectionResponse{}
+	if req.GetAttachmentContext().GetHost() == nil {
+		return resp, nil
+	}
+	for _, hook := range []struct {
+		target string
+		kind   datapathplugins.HookType
+	}{
+		{"cil_from_netdev", datapathplugins.HookType_PRE},
+		{"cil_to_netdev", datapathplugins.HookType_POST},
+	} {
+		if _, ok := req.GetCollection().GetPrograms()[hook.target]; ok {
+			resp.Hooks = append(resp.Hooks, &datapathplugins.PrepareCollectionResponse_HookSpec{Target: hook.target, Type: hook.kind})
+		}
+	}
+	return resp, nil
+}
+
+func (p *terwayPlugin) collectionSpec(ctx context.Context) (*ebpf.CollectionSpec, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.spec == nil {
+		dir, err := os.MkdirTemp(option.Config.StateDir, "terway-datapath-")
+		if err != nil {
+			return nil, err
+		}
+		defer os.RemoveAll(dir)
+		object, err := compile(ctx, p.logger, &progInfo{Source: "bpf_terway.c", Output: "bpf_terway.o", OutputType: outputObject}, &directoryInfo{
+			Library: option.Config.BpfDir, Runtime: option.Config.StateDir,
+			State: option.Config.StateDir, Output: dir,
+		})
+		if err != nil {
+			return nil, err
+		}
+		p.spec, err = ebpf.LoadCollectionSpec(object)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return p.spec.Copy(), nil
+}
+
+func (p *terwayPlugin) InstrumentCollection(ctx context.Context, req *datapathplugins.InstrumentCollectionRequest, _ ...grpc.CallOption) (*datapathplugins.InstrumentCollectionResponse, error) {
+	for _, hook := range req.GetHooks() {
+		spec, err := p.collectionSpec(ctx)
+		if err != nil {
+			return nil, fmt.Errorf("compile Terway datapath: %w", err)
+		}
+		name := "terway_ingress"
+		if hook.GetType() == datapathplugins.HookType_POST {
+			name = "terway_egress"
+		}
+		prog := spec.Programs[name]
+		if prog == nil {
+			return nil, fmt.Errorf("missing Terway hook %s", name)
+		}
+		target, err := ebpf.NewProgramFromID(ebpf.ProgramID(hook.GetAttachTarget().GetProgramId()))
+		if err != nil {
+			return nil, err
+		}
+		prog.AttachTarget = target
+		prog.AttachTo = hook.GetAttachTarget().GetSubprogName()
+		spec.Programs = map[string]*ebpf.ProgramSpec{name: prog}
+		coll, err := ebpf.NewCollection(spec)
+		target.Close()
+		if err != nil {
+			return nil, fmt.Errorf("load Terway hook %s: %w", name, err)
+		}
+		err = coll.Programs[name].Pin(filepath.Clean(hook.GetPinPath()))
+		coll.Close()
+		if err != nil {
+			return nil, err
+		}
+	}
+	return &datapathplugins.InstrumentCollectionResponse{}, nil
+}
diff --git a/pkg/datapath/loader/terway_test.go b/pkg/datapath/loader/terway_test.go
