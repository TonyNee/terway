diff --git a/bpf/bpf_terway.c b/bpf/bpf_terway.c
index ed5773f87f..da30d1c997 100644
--- a/bpf/bpf_terway.c
+++ b/bpf/bpf_terway.c
@@ -3,11 +3,33 @@
 
 #include <bpf/ctx/skb.h>
 #include <bpf/section.h>
+#include "lib/terway.h"
 
 /* -1 means continue the datapath plugin dispatcher, not TC_ACT_OK. */
 __section("freplace")
-int terway_ingress(struct __ctx_buff *ctx __maybe_unused)
+int terway_ingress(struct __ctx_buff *ctx)
 {
+	__u16 proto;
+
+	if (!terway_managed_parent(ctx->ifindex))
+		return -1;
+	terway_count(TERWAY_HOOK_RUN);
+	if (skb_load_bytes(ctx, 12, &proto, sizeof(proto)) < 0)
+		return terway_drop(TERWAY_DROP_INVALID);
+	if (proto == bpf_htons(0x88a8))
+		return terway_drop(TERWAY_DROP_INVALID);
+	if (!ctx->vlan_present && proto != bpf_htons(0x8100))
+		return -1;
+	/* The hypervisor owns ingress VLAN classification, just as for the legacy
+	 * TC VLAN pop rule. Do not remove service, policy, or routing processing.
+	 */
+	if (skb_vlan_pop(ctx) < 0)
+		return terway_drop(TERWAY_DROP_POP);
+	if (skb_load_bytes(ctx, 12, &proto, sizeof(proto)) < 0 ||
+	    ctx->vlan_present || proto == bpf_htons(0x8100) ||
+	    proto == bpf_htons(0x88a8))
+		return terway_drop(TERWAY_DROP_INVALID);
+	terway_count(TERWAY_INGRESS_POP);
 	return -1;
 }
 
diff --git a/bpf/lib/terway.h b/bpf/lib/terway.h
new file mode 100644
index 0000000000..a9fccd0d56
--- /dev/null
+++ b/bpf/lib/terway.h
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/* Copyright Authors of Cilium */
+
+#pragma once
+
+#include <bpf/ctx/skb.h>
+#include <bpf/section.h>
+#include <bpf/api.h>
+#include "endian.h"
+
+static long BPF_FUNC(skb_vlan_pop, struct __sk_buff *ctx);
+static long BPF_FUNC(skb_vlan_push, struct __sk_buff *ctx, __be16 proto, __u16 vlan);
+
+enum terway_key_kind {
+	TERWAY_PARENT = 0,
+	TERWAY_LINK = 1,
+	TERWAY_IPV4 = 4,
+	TERWAY_IPV6 = 6,
+};
+
+struct terway_key {
+	__u32 ifindex;
+	__u32 kind;
+	__u8 address[16];
+};
+
+struct terway_value {
+	__u32 parent;
+	__u32 owner;
+	__u16 vlan;
+	__u16 pad;
+	__u8 mac[6];
+	__u16 pad2;
+};
+
+struct {
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__type(key, struct terway_key);
+	__type(value, struct terway_value);
+	__uint(max_entries, 262144);
+	__uint(map_flags, BPF_F_RDONLY_PROG);
+} cilium_twvlan __section_maps_btf;
+
+struct {
+	__uint(type, BPF_MAP_TYPE_PERCPU_ARRAY);
+	__type(key, __u32);
+	__type(value, __u64);
+	__uint(max_entries, 8);
+} cilium_twstats __section_maps_btf;
+
+enum terway_stat {
+	TERWAY_INGRESS_POP,
+	TERWAY_EGRESS_PUSH,
+	TERWAY_DROP_INVALID,
+	TERWAY_DROP_POP,
+	TERWAY_DROP_PUSH,
+	TERWAY_DROP_BINDING,
+	TERWAY_NORMALIZE_PIPE,
+	TERWAY_HOOK_RUN,
+};
+
+static __always_inline void terway_count(__u32 reason)
+{
+	__u64 *counter = map_lookup_elem(&cilium_twstats, &reason);
+
+	if (counter)
+		(*counter)++;
+}
+
+/* Bound by the loader to the actual device's MAC. This prevents restored
+ * state for a recycled ifindex from claiming an unrelated new interface.
+ */
+const volatile __u8 terway_parent_mac[6];
+
+static __always_inline bool terway_managed_parent(__u32 ifindex)
+{
+	struct terway_key key = { .ifindex = ifindex, .kind = TERWAY_PARENT };
+	const struct terway_value *parent = map_lookup_elem(&cilium_twvlan, &key);
+
+	if (!parent)
+		return false;
+#pragma unroll
+	for (int i = 0; i < 6; i++)
+		if (parent->mac[i] != terway_parent_mac[i])
+			return false;
+	return true;
+}
+
+static __always_inline int terway_drop(__u32 reason)
+{
+	terway_count(reason);
+	return CTX_ACT_DROP;
+}
diff --git a/bpf/test-progs/bpf_terway_base.c b/bpf/test-progs/bpf_terway_base.c
new file mode 100644
index 0000000000..f501ecf05d
--- /dev/null
+++ b/bpf/test-progs/bpf_terway_base.c
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/* Copyright Authors of Cilium */
+
+#include <bpf/ctx/skb.h>
+#include <bpf/api.h>
+
+const volatile __u32 test_verdict;
+const volatile __u32 test_nat_source;
+
+__section_entry
+int cil_from_netdev(struct __ctx_buff *ctx __maybe_unused)
+{
+	return test_verdict;
+}
+
+__section_entry
+int cil_to_netdev(struct __ctx_buff *ctx)
+{
+	if (test_nat_source) {
+		__u32 source = test_nat_source;
+
+		if (skb_store_bytes(ctx, 26, &source, sizeof(source), 0) < 0)
+			return CTX_ACT_DROP;
+	}
+	return test_verdict;
+}
+
+struct {
+	__uint(type, BPF_MAP_TYPE_ARRAY);
+	__type(key, __u32);
+	__uint(value_size, 16);
+	__uint(max_entries, 1);
+} tw_observe __section_maps_btf;
+
+/* A second POST plugin observes the skb after the Terway hook. This tests
+ * actual kernel VLAN metadata, not just a userspace model of the algorithm.
+ */
+__section("freplace")
+int terway_observe(struct __ctx_buff *ctx, int ret)
+{
+	__u32 zero = 0;
+	__u32 result[4] = { ctx->vlan_present, ctx->vlan_tci, ret, ctx->protocol };
+
+	map_update_elem(&tw_observe, &zero, result, 0);
+	return -1;
+}
+
+BPF_LICENSE("Dual BSD/GPL");
