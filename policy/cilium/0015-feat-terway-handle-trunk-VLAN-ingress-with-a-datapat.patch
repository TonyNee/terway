diff --git a/pkg/datapath/loader/terway_privileged_test.go b/pkg/datapath/loader/terway_privileged_test.go
new file mode 100644
index 0000000000..d5fe8d5dba
--- /dev/null
+++ b/pkg/datapath/loader/terway_privileged_test.go
@@ -0,0 +1,204 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package loader
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/rlimit"
+	"github.com/cilium/hive/hivetest"
+	"github.com/stretchr/testify/require"
+	"github.com/vishvananda/netlink"
+	"google.golang.org/grpc"
+
+	"github.com/cilium/cilium/api/v1/datapathplugins"
+	"github.com/cilium/cilium/pkg/bpf"
+	"github.com/cilium/cilium/pkg/datapath/config"
+	plugin "github.com/cilium/cilium/pkg/datapath/plugins/types"
+	api_v2alpha1 "github.com/cilium/cilium/pkg/k8s/apis/cilium.io/v2alpha1"
+	"github.com/cilium/cilium/pkg/maps/terwaymap"
+	"github.com/cilium/cilium/pkg/terway"
+	"github.com/cilium/cilium/pkg/testutils"
+)
+
+func loadTerwayTestSpec(t *testing.T, source string) *ebpf.CollectionSpec {
+	t.Helper()
+	object := filepath.Join(os.Getenv("CILIUM_TERWAY_BPF_OBJECTS"), filepath.Base(source[:len(source)-2])+".o")
+	if os.Getenv("CILIUM_TERWAY_BPF_OBJECTS") == "" {
+		var err error
+		object, err = compile(t.Context(), hivetest.Logger(t), &progInfo{Source: source, Output: filepath.Base(object), OutputType: outputObject}, getDirs(t))
+		require.NoError(t, err)
+	}
+	spec, err := ebpf.LoadCollectionSpec(object)
+	require.NoError(t, err)
+	return spec
+}
+
+type terwayObserver struct {
+	spec       *ebpf.CollectionSpec
+	collection *ebpf.Collection
+}
+
+func (*terwayObserver) Name() string { return "terway_test_observer" }
+func (*terwayObserver) AttachmentPolicy() api_v2alpha1.CiliumDatapathPluginAttachmentPolicy {
+	return api_v2alpha1.AttachmentPolicyAlways
+}
+func (p *terwayObserver) DeepEqual(other plugin.Plugin) bool { return p == other }
+func (*terwayObserver) PrepareCollection(_ context.Context, _ *datapathplugins.PrepareCollectionRequest, _ ...grpc.CallOption) (*datapathplugins.PrepareCollectionResponse, error) {
+	return &datapathplugins.PrepareCollectionResponse{Hooks: []*datapathplugins.PrepareCollectionResponse_HookSpec{{Target: "cil_to_netdev", Type: datapathplugins.HookType_POST, Constraints: []*datapathplugins.PrepareCollectionResponse_HookSpec_OrderingConstraint{{Order: datapathplugins.PrepareCollectionResponse_HookSpec_OrderingConstraint_AFTER, Plugin: "terway_vlan"}}}}}, nil
+}
+func (p *terwayObserver) InstrumentCollection(_ context.Context, req *datapathplugins.InstrumentCollectionRequest, _ ...grpc.CallOption) (*datapathplugins.InstrumentCollectionResponse, error) {
+	hook := req.Hooks[0]
+	target, err := ebpf.NewProgramFromID(ebpf.ProgramID(hook.AttachTarget.ProgramId))
+	if err != nil {
+		return nil, err
+	}
+	defer target.Close()
+	spec := p.spec.Copy()
+	prog := spec.Programs["terway_observe"]
+	prog.AttachTarget, prog.AttachTo = target, hook.AttachTarget.SubprogName
+	spec.Programs = map[string]*ebpf.ProgramSpec{"terway_observe": prog}
+	p.collection, err = ebpf.NewCollection(spec)
+	if err != nil {
+		return nil, err
+	}
+	if err := p.collection.Programs["terway_observe"].Pin(hook.PinPath); err != nil {
+		return nil, err
+	}
+	return &datapathplugins.InstrumentCollectionResponse{}, nil
+}
+
+type terwayTestPrograms struct {
+	base        *ebpf.Collection
+	observer    *terwayObserver
+	parent, pod uint32
+	store       *terwaymap.Store
+}
+
+func newTerwayTestPrograms(t *testing.T, verdict uint32, source [4]byte) terwayTestPrograms {
+	t.Helper()
+	testutils.PrivilegedTest(t)
+	require.NoError(t, rlimit.RemoveMemlock())
+	logger := hivetest.Logger(t)
+	require.NoError(t, bpf.MkdirBPF(filepath.Dir(bpf.MapPath(logger, terwaymap.MapName))))
+	store, err := terwaymap.Open(logger, false)
+	require.NoError(t, err)
+	t.Cleanup(func() {
+		store.Close()
+		os.Remove(bpf.MapPath(logger, terwaymap.MapName))
+		os.Remove(bpf.MapPath(logger, terwaymap.StatsMapName))
+	})
+	createLink := func(name string) uint32 {
+		hw, err := net.ParseMAC("02:00:00:00:00:01")
+		require.NoError(t, err)
+		d := &netlink.Dummy{LinkAttrs: netlink.LinkAttrs{Name: name, HardwareAddr: hw}}
+		require.NoError(t, netlink.LinkAdd(d))
+		t.Cleanup(func() { netlink.LinkDel(d) })
+		return uint32(d.Attrs().Index)
+	}
+	parent, pod := createLink("tw-parent"), createLink("tw-pod")
+	require.NoError(t, store.Upsert(1, pod, parent, []netip.Addr{netip.MustParseAddr("10.0.0.2"), netip.MustParseAddr("fd00::2")}, terway.Binding{VLAN: 42, ParentMAC: "02:00:00:00:00:01"}, nil))
+	spec := loadTerwayTestSpec(t, "test-progs/bpf_terway_base.c")
+	observer := &terwayObserver{spec: spec.Copy()}
+	t.Cleanup(func() {
+		if observer.collection != nil {
+			observer.collection.Close()
+		}
+	})
+	delete(spec.Programs, "terway_observe")
+	require.NoError(t, spec.Variables["test_verdict"].Set(verdict))
+	require.NoError(t, spec.Variables["test_nat_source"].Set(binary.NativeEndian.Uint32(source[:])))
+	p := &terwayPlugin{logger: logger, spec: loadTerwayTestSpec(t, "bpf_terway.c")}
+	plugins := plugin.Plugins{p.Name(): p, observer.Name(): observer}
+	tmp := testutils.TempBPFFS(t)
+	l := newBPFCollectionLoader(true, filepath.Join(tmp, "operations"))
+	base, commit, cleanup, err := l.Load(t.Context(), logger, spec, &bpf.CollectionOptions{}, &config.Config{Plugins: plugins}, &datapathplugins.AttachmentContext{Context: &datapathplugins.AttachmentContext_Host_{Host: &datapathplugins.AttachmentContext_Host{Iface: &datapathplugins.AttachmentContext_InterfaceInfo{Name: "tw-parent"}}}}, filepath.Join(tmp, "pins"))
+	require.NoError(t, maybeReportVerifierError(err))
+	require.NoError(t, commit())
+	cleanup()
+	t.Cleanup(base.Close)
+	return terwayTestPrograms{base: base, observer: observer, parent: parent, pod: pod, store: store}
+}
+
+func testFrame(proto uint16, vlan bool) []byte {
+	frame := make([]byte, 14+64)
+	copy(frame[:6], []byte{2, 0, 0, 0, 0, 1})
+	binary.BigEndian.PutUint16(frame[12:14], proto)
+	if proto == 0x0800 {
+		frame[14] = 0x45
+		copy(frame[26:30], []byte{10, 0, 0, 2})
+	}
+	if proto == 0x86dd {
+		frame[14] = 0x60
+		ip := netip.MustParseAddr("fd00::2").As16()
+		copy(frame[22:38], ip[:])
+	}
+	if !vlan {
+		return frame
+	}
+	tagged := make([]byte, len(frame)+4)
+	copy(tagged[:12], frame[:12])
+	binary.BigEndian.PutUint16(tagged[12:14], 0x8100)
+	binary.BigEndian.PutUint16(tagged[14:16], 42)
+	copy(tagged[16:], frame[12:])
+	return tagged
+}
+
+func (p terwayTestPrograms) run(t *testing.T, target string, frame []byte, ingress uint32) (uint32, []byte) {
+	t.Helper()
+	var ctx [48]uint32
+	ctx[9], ctx[10] = ingress, p.parent
+	data := make([]byte, len(frame)+64)
+	opts := &ebpf.RunOptions{Data: frame, DataOut: data, Context: ctx}
+	ret, err := p.base.Programs[target].Run(opts)
+	require.NoError(t, err)
+	return ret, opts.DataOut
+}
+
+func TestPrivilegedTerwayIngress(t *testing.T) {
+	testutils.PrivilegedTest(t)
+	for _, proto := range []uint16{0x0800, 0x86dd, 0x0806} {
+		t.Run(fmt.Sprintf("ethertype-%x", proto), func(t *testing.T) {
+			p := newTerwayTestPrograms(t, 0, [4]byte{})
+			frame := testFrame(proto, true)
+			ret, out := p.run(t, "cil_from_netdev", frame, p.parent)
+			require.Equal(t, uint32(0), ret)
+			require.Equal(t, testFrame(proto, false), out)
+		})
+	}
+	t.Run("double-tag", func(t *testing.T) {
+		p := newTerwayTestPrograms(t, 0, [4]byte{})
+		ret, _ := p.run(t, "cil_from_netdev", testFrame(0x8100, true), p.parent)
+		require.Equal(t, uint32(2), ret)
+	})
+	t.Run("unmanaged", func(t *testing.T) {
+		p := newTerwayTestPrograms(t, 0, [4]byte{})
+		require.NoError(t, p.store.Delete(1))
+		frame := testFrame(0x0800, true)
+		ret, out := p.run(t, "cil_from_netdev", frame, p.parent)
+		require.Equal(t, uint32(0), ret)
+		require.Equal(t, frame, out)
+	})
+	t.Run("qinq", func(t *testing.T) {
+		p := newTerwayTestPrograms(t, 0, [4]byte{})
+		ret, _ := p.run(t, "cil_from_netdev", testFrame(0x88a8, false), p.parent)
+		require.Equal(t, uint32(2), ret)
+	})
+	t.Run("recycled-parent-ifindex", func(t *testing.T) {
+		p := newTerwayTestPrograms(t, 0, [4]byte{})
+		require.NoError(t, p.store.Upsert(1, p.pod, p.parent, []netip.Addr{netip.MustParseAddr("10.0.0.2")}, terway.Binding{VLAN: 42, ParentMAC: "02:00:00:00:00:02"}, nil))
+		frame := testFrame(0x0800, true)
+		ret, out := p.run(t, "cil_from_netdev", frame, p.parent)
+		require.Equal(t, uint32(0), ret)
+		require.Equal(t, frame, out)
+	})
+}
