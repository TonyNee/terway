@@ -553,6 +554,34 @@ func (ep *Endpoint) UnmarshalJSON(raw []byte) error {
 	}
 
 	ep.fromSerializedEndpoint(restoredEp)
+	if option.Config.EnableTerwayDatapath && !ep.IsHost() {
+		binding, present, err := terway.ParseBinding(ep.GetPropertyValue)
+		if err != nil {
+			return err
+		}
+		// Ordinary endpoints have no VLAN binding and retain their serialized
+		// parent interface. Only trunk endpoints need MAC-based restoration.
+		if !present || binding.VLAN == 0 {
+			return nil
+		}
+		links, err := safenetlink.LinkList()
+		if err != nil {
+			return err
+		}
+		parent := 0
+		for _, link := range links {
+			if link.Attrs().HardwareAddr.String() == binding.ParentMAC {
+				if parent != 0 {
+					return fmt.Errorf("ambiguous restored Terway parent ENI")
+				}
+				parent = link.Attrs().Index
+			}
+		}
+		if parent == 0 {
+			return fmt.Errorf("restored Terway parent ENI not found")
+		}
+		ep.parentIfIndex = parent
+	}
 	return nil
 }
 
