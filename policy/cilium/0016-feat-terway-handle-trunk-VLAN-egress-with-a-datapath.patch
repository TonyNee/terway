+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package option
+
+import (
+	"testing"
+
+	"github.com/spf13/viper"
+	"github.com/stretchr/testify/require"
+)
+
+func TestTerwayRejectsUnsupportedDatapaths(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		configure func(*DaemonConfig)
+		message   string
+	}{
+		{"overlay", func(c *DaemonConfig) { c.RoutingMode = RoutingModeTunnel }, "requires native routing"},
+		{"bypass", func(c *DaemonConfig) { c.VLANBPFBypass = []int{42} }, "cannot be combined"},
+		{"egress-gateway", func(c *DaemonConfig) { c.EnableEgressGateway = true }, "does not support"},
+		{"xdp", func(c *DaemonConfig) { c.NodePortAcceleration = NodePortAccelerationNative }, "does not support"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			c := &DaemonConfig{EnableTerwayDatapath: true, RoutingMode: RoutingModeNative}
+			tc.configure(c)
+			require.ErrorContains(t, c.Validate(viper.New()), tc.message)
+		})
+	}
+}
