 	if (test_nat_source) {
 		__u32 source = test_nat_source;
+		__u32 offset = ctx->protocol == bpf_htons(0x86dd) ? 22 : 26;
 
-		if (skb_store_bytes(ctx, 26, &source, sizeof(source), 0) < 0)
+		if (skb_store_bytes(ctx, offset, &source, sizeof(source), 0) < 0)
 			return CTX_ACT_DROP;
 	}
 	return test_verdict;
 }
 
+__section_entry
+int terway_tail(struct __ctx_buff *ctx)
+{
+	return test_egress(ctx);
+}
+
+__section_entry
+int cil_to_netdev(struct __ctx_buff *ctx)
+{
+	if (test_tail_call) {
+		tail_call(ctx, &tw_tail, 0);
+		return CTX_ACT_DROP;
+	}
+	return test_egress(ctx);
+}
+
 struct {
 	__uint(type, BPF_MAP_TYPE_ARRAY);
 	__type(key, __u32);
