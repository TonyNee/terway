+
+func TestTerwayDatapathModeAgreement(t *testing.T) {
+	old := option.Config.EnableTerwayDatapath
+	t.Cleanup(func() { option.Config.EnableTerwayDatapath = old })
+	for _, enabled := range []bool{false, true} {
+		option.Config.EnableTerwayDatapath = enabled
+		for _, present := range []bool{false, true} {
+			ep := &Endpoint{properties: map[string]any{}}
+			if present {
+				ep.properties = (terway.Binding{VLAN: 42, ParentMAC: "02:00:00:00:00:01"}).Properties()
+			}
+			err := ep.validateTerwayBinding()
+			if enabled || !present {
+				require.NoError(t, err)
+			} else {
+				require.Error(t, err)
+			}
+		}
+	}
+}
+
+func TestOrdinaryEndpointRestoreWithTerwayDatapath(t *testing.T) {
+	old := option.Config.EnableTerwayDatapath
+	option.Config.EnableTerwayDatapath = true
+	t.Cleanup(func() { option.Config.EnableTerwayDatapath = old })
+	for _, properties := range []map[string]any{nil, (terway.Binding{VLAN: 0, ParentMAC: "02:00:00:00:00:01"}).Properties()} {
+		ep := &Endpoint{parentIfIndex: 12345, properties: properties}
+		raw, err := ep.MarshalJSON()
+		require.NoError(t, err)
+		restored := &Endpoint{}
+		require.NoError(t, restored.UnmarshalJSON(raw))
+		require.Equal(t, 12345, restored.parentIfIndex)
+		require.NoError(t, restored.validateTerwayBinding())
+	}
+}
+
+func TestLegacyZeroVLANDoesNotRequireTerwayDatapath(t *testing.T) {
+	old := option.Config.EnableTerwayDatapath
+	option.Config.EnableTerwayDatapath = false
+	t.Cleanup(func() { option.Config.EnableTerwayDatapath = old })
+	ep := &Endpoint{properties: (terway.Binding{VLAN: 0, ParentMAC: "02:00:00:00:00:01"}).Properties()}
+	require.NoError(t, ep.validateTerwayBinding())
+}
