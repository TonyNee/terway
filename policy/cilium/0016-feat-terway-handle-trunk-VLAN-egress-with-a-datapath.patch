new file mode 100644
index 0000000000..0d9d4926c3
--- /dev/null
+++ b/Documentation/network/ebpf/terway-datapath.rst
@@ -0,0 +1,84 @@
+Built-in Terway VLAN datapath
+============================
+
+The opt-in Terway extension replaces trunk VLAN pop/push actions with datapath
+plugin hooks inside ``cilium-agent``. It does not require a separate plugin
+container, plugin Unix socket, or ``CiliumDatapathPlugin`` resource.
+Kubernetes-managed datapath plugins can remain disabled.
+
+Enable the agent with ``--enable-terway-datapath=true`` and set
+``"terway-datapath": true`` on the ``cilium-cni`` entry in the CNI chain.
+For marked trunk interfaces, the chainer reads the allocation using Terway's
+existing ``GetIPInfo`` RPC; it never allocates or releases ENIs or addresses.
+The agent rejects nonzero VLAN bindings when its Terway datapath is disabled,
+and accepts ordinary endpoints without VLAN properties in either mode.
+
+This change supplies the Cilium side of the integration. Before enabling it,
+the Terway datapath must stop installing its legacy VLAN TC rules and remove
+existing rules as part of the node migration. In particular, legacy egress
+push actions must not run after the plugin, which would add a second tag.
+Recreate workloads on drained nodes: endpoints created by the old chainer do
+not have the binding metadata required for recovery in the new mode.
+
+Bindings are stored in the existing endpoint properties and restored with
+the endpoint. ``cilium_twvlan`` contains parent, endpoint-interface, and address
+bindings. Entries carry an endpoint owner so that a late delete cannot remove
+an address reassigned to a new endpoint. The parent MAC protects against
+ifindex reuse, and recovery resolves the current parent interface by MAC.
+
+Ingress hooks remove one VLAN tag before Cilium handles the packet. QinQ is
+rejected. Egress hooks use the source endpoint's ingress interface, preserving
+the binding across source-address translation, with address lookup as a
+fallback. Policy drops and redirects are preserved. ARP is untagged on ingress
+and keeps its existing egress behavior. Legacy TC PIPE verdicts are normalized
+when TCX is configured and available on the running kernel.
+
+The initial scope is native, unencrypted routing. VLAN bypass, Egress Gateway,
+and XDP acceleration are rejected; overlay, encryption, and QinQ are not
+supported. Netkit device creation and chainer support are separate follow-up
+work; the hooks operate on the parent NIC and can first be tested with veth.
+
+The pinned per-CPU map ``cilium_twstats`` exposes these counter indexes:
+
+* 0: ingress VLAN pop
+* 1: egress VLAN push
+* 2: invalid packet or nested VLAN
+* 3: VLAN pop failure
+* 4: VLAN push failure
+* 5: inconsistent endpoint/parent binding
+* 6: legacy PIPE verdict normalization
+* 7: hooks run on managed parents
+
+Validation
+----------
+
+The Go tests cover the read-only backend exchange, allocation matching,
+binding validation, map transactions, IP reuse, and orphan cleanup.
+``TestPrivilegedTerwayIngress`` and ``TestPrivilegedTerwayEgress`` load the
+hooks through Cilium's real datapath plugin dispatcher and kernel verifier.
+A second POST plugin observes the resulting kernel VLAN metadata. The base
+program can rewrite source addresses, including through a tail call, to
+exercise NAT identity preservation.
+
+Run privileged tests on Linux with ``PRIVILEGED_TESTS=true``, mounted bpffs,
+and clang available. Alternatively, compile ``bpf/bpf_terway.c`` and
+``bpf/test-progs/bpf_terway_base.c`` into a directory, then set
+``CILIUM_TERWAY_BPF_OBJECTS`` to that directory when running the tests.
+These tests complement actual trunk-node, Service, NetworkPolicy, and NIC
+VLAN-offload validation; they do not replace those integration tests.
+
+Scope and ordinary endpoints
+----------------------------
+
+The agent enables the extension at node scope. The primary Terway CNI sets
+``terway-trunk-datapath`` as the host veth alias only for DP trunk allocations.
+The Terway chainer recognizes this alias in the existing peer-link lookup and
+queries the backend only for these interfaces. The alias is kernel interface
+metadata and does not change CNI result types or packet routing. Ship both CNI
+binaries with this contract and recreate trunk endpoints when switching modes.
+
+Ordinary endpoints keep the original parent-ENI inference, do not require
+Terway VLAN properties or an additional backend RPC, and retain their normal
+creation, restore and deletion paths. Only nonzero VLAN bindings enter the
+extension's map transactions. Ordinary packets can traverse node hooks and
+continue without VLAN actions when no trunk binding matches.
diff --git a/bpf/bpf_terway.c b/bpf/bpf_terway.c
index da30d1c997..35a1056849 100644
--- a/bpf/bpf_terway.c
+++ b/bpf/bpf_terway.c
@@ -34,9 +34,76 @@ int terway_ingress(struct __ctx_buff *ctx)
 }
 
 __section("freplace")
-int terway_egress(struct __ctx_buff *ctx __maybe_unused, int ret __maybe_unused)
+int terway_egress(struct __ctx_buff *ctx, int ret)
 {
-	return -1;
+	struct terway_key link_key = {
+		.ifindex = ctx->ingress_ifindex,
+		.kind = TERWAY_LINK,
+	};
+	struct terway_key source_key = { .ifindex = ctx->ifindex };
+	const struct terway_value *link, *source, *binding;
+	__u16 proto;
+	int proceed = -1;
+
+	/* A POST hook must never turn a policy drop or redirect into a pass.
+	 * TC_ACT_PIPE is a legacy Terway patch, not a valid TCX verdict.
+	 */
+	if (ret != CTX_ACT_OK && ret != CTX_ACT_PIPE && ret != -1)
+		return -1;
+	if (ret == CTX_ACT_PIPE && terway_normalize_pipe) {
+		terway_count(TERWAY_NORMALIZE_PIPE);
+		proceed = CTX_ACT_OK;
+	}
+	if (!terway_managed_parent(ctx->ifindex))
+		return proceed;
+	terway_count(TERWAY_HOOK_RUN);
+	link = map_lookup_elem(&cilium_twvlan, &link_key);
+	if (skb_load_bytes(ctx, 12, &proto, sizeof(proto)) < 0)
+		return terway_drop(TERWAY_DROP_INVALID);
+	if (link && (proto == bpf_htons(0x8100) || proto == bpf_htons(0x88a8)))
+		return terway_drop(TERWAY_DROP_BINDING);
+	if (proto == bpf_htons(0x0800)) {
+		source_key.kind = TERWAY_IPV4;
+		if (skb_load_bytes(ctx, 26, source_key.address, 4) < 0)
+			return terway_drop(TERWAY_DROP_INVALID);
+	} else if (proto == bpf_htons(0x86dd)) {
+		source_key.kind = TERWAY_IPV6;
+		if (skb_load_bytes(ctx, 22, source_key.address, 16) < 0)
+			return terway_drop(TERWAY_DROP_INVALID);
+	} else {
+		/* The legacy egress rules only tag IP traffic. Host ARP and other
+		 * control traffic continue to use their existing paths.
+		 */
+		return proceed;
+	}
+	source = map_lookup_elem(&cilium_twvlan, &source_key);
+	if (link && link->parent != ctx->ifindex)
+		return terway_drop(TERWAY_DROP_BINDING);
+	if (link && source && link->owner != source->owner)
+		return terway_drop(TERWAY_DROP_BINDING);
+	/* skb_iif identifies the source endpoint even after Cilium rewrites the
+	 * source address (SNAT or service reverse NAT). Do not borrow skb->cb or
+	 * skb->mark: Cilium owns and clears those fields. Address lookup is only
+	 * a fallback for traffic without a local endpoint ingress interface.
+	 */
+	binding = link ? link : source;
+	if (!binding)
+		return proceed;
+	if (!binding->owner || !binding->vlan || binding->vlan > 4094)
+		return terway_drop(TERWAY_DROP_BINDING);
+#pragma unroll
+	for (int i = 0; i < 6; i++)
+		if (binding->mac[i] != terway_parent_mac[i])
+			return terway_drop(TERWAY_DROP_BINDING);
+	if (ctx->vlan_present) {
+		if ((ctx->vlan_tci & 0xfff) != binding->vlan)
+			return terway_drop(TERWAY_DROP_BINDING);
+		return proceed;
+	}
+	if (skb_vlan_push(ctx, bpf_htons(0x8100), binding->vlan) < 0)
+		return terway_drop(TERWAY_DROP_PUSH);
+	terway_count(TERWAY_EGRESS_PUSH);
+	return proceed;
 }
 
 BPF_LICENSE("Dual BSD/GPL");
