+func TestPrivilegedTerwayEgress(t *testing.T) {
+	testutils.PrivilegedTest(t)
+	for _, proto := range []uint16{0x0800, 0x86dd} {
+		t.Run(fmt.Sprintf("ethertype-%x", proto), func(t *testing.T) {
